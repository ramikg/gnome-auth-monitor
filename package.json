{
    "name": "gnome-auth-monitor",
    "author": "ramikg",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc",
        "format": "prettier --check .",
        "lint": "eslint .",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/config-helpers": "^0.7.0",
        "@girs/gjs": "^5.6.0",
        "@girs/gnome-shell": "^50.0.4",
        "eslint": "^10.13.0",
        "eslint-config-gnome": "git+https://gitlab.gnome.org/World/javascript/eslint-config-gnome.git#c479d059e8d9ea99c3b53c2ea43abf7fdb05eb51",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 90,
        "singleQuote": true,
        "trailingComma": "es5",
        "bracketSpacing": false,
        "arrowParens": "avoid"
    },
    "lint-staged": {
        "**/*.{js,ts,json,md,yaml}": [
            "prettier --write",
            "eslint"
        ]
    }
}
